# Server-side only. NEVER prefix this with VITE_ — anything VITE_-prefixed is
# inlined into the frontend bundle and readable by every visitor.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional, defaults to 5001 (matches the frontend's /api proxy).
PORT=5001

# Email Configuration (Required for OTP email verification)
# -------------------------------------------------------------
# Option 1: Resend HTTP API (RECOMMENDED for Render Free Tier)
# Render Free Tier blocks outbound SMTP ports 25, 465, and 587.
# Resend uses HTTPS port 443, which works 100% reliably on Render.
# 1. Sign up free (3,000 emails/month): https://resend.com
# 2. Go to API Keys -> Create API Key
# 3. Add to Render:
RESEND_API_KEY=re_your_resend_api_key_here
# Optional: defaults to "TaskPanda AI <onboarding@resend.dev>"
RESEND_FROM="TaskPanda AI <onboarding@resend.dev>"

# Option 2: Brevo HTTP API (Alternative for Render Free Tier - 300 free emails/day)
# 1. Sign up free: https://www.brevo.com
# 2. Go to SMTP & API -> API Keys -> Generate Key
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# BREVO_SENDER_EMAIL=your-verified-email@example.com

# Option 3: Gmail SMTP (For Local Development or Paid Hosting)
# Note: Render Free Tier blocks SMTP ports.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="TaskPanda AI <your-email@gmail.com>"

# Optional custom secret for OTP hashing salt
OTP_SECRET=your_custom_secure_otp_salt_here

