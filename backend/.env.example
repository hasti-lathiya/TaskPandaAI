# Server-side only. NEVER prefix this with VITE_ — anything VITE_-prefixed is
# inlined into the frontend bundle and readable by every visitor.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional, defaults to 5001 (matches the frontend's /api proxy).
PORT=5001

# SMTP Email Configuration (Required for OTP email verification)
# Option A: Gmail SMTP
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password into SMTP_PASS (spaces are auto-stripped)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional: Set display name. Defaults to "TaskPanda AI <your-email@gmail.com>"
SMTP_FROM="TaskPanda AI <your-email@gmail.com>"

# Option B: Other SMTP Providers (Brevo, SendGrid, Mailgun, Amazon SES)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-key

# Optional custom secret for OTP hashing salt
OTP_SECRET=your_custom_secure_otp_salt_here

